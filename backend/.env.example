# Copy this file to ".env" and fill in real values. Never commit the real .env.

# --- Database (MySQL) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# XAMPP default: user "root", empty password, port 3306.
DATABASE_URL="mysql://root:@localhost:3306/finbooks"

# --- Auth ---
# Use a long random string in a real deployment (e.g. `openssl rand -hex 32`).
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
CORS_ORIGIN="http://localhost:5173"
