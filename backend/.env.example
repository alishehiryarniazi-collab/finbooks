# Copy this file to ".env" and fill in real values. Never commit the real .env.

# --- Database (MySQL) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# XAMPP default: user "root", empty password, port 3306.
DATABASE_URL="mysql://root:@localhost:3306/finbooks"

# --- Auth ---
# Use a long random string in a real deployment (e.g. `openssl rand -hex 32`).
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=4001
CORS_ORIGIN="http://localhost:5173"

# Password-reset link points at the frontend:
APP_URL="http://localhost:5173"
# Optional: send real reset emails via Gmail (SMTP_PASS = a Gmail App Password, not your normal one).
# Leave unset to have the reset link printed to the server console instead.
# SMTP_USER="youraddress@gmail.com"
# SMTP_PASS="your-16-char-app-password"
